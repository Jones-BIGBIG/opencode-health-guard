{
  "name": "@jones-bigbig/opencode-health-guard",
  "version": "1.0.0",
  "description": "Boot-Time Self-Check Gateway for OpenCode - 启动前健康检查插件",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --sourcemap --minify",
    "dev": "bun build ./src/index.ts --outdir ./dist --target bun --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "opencode",
    "plugin",
    "health-check",
    "self-check",
    "boot-time",
    "gateway",
    "configuration-validation"
  ],
  "author": "Jones-BIGBIG <neal08390@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jones-BIGBIG/opencode-health-guard.git"
  },
  "bugs": {
    "url": "https://github.com/Jones-BIGBIG/opencode-health-guard/issues"
  },
  "homepage": "https://github.com/Jones-BIGBIG/opencode-health-guard#readme",
  "peerDependencies": {
    "@opencode-ai/plugin": ">=0.1.0",
    "@opencode-ai/sdk": ">=0.1.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "latest",
    "@opencode-ai/sdk": "latest",
    "@types/bun": "latest",
    "typescript": "^5.3.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "opencode": {
    "plugin": true,
    "displayName": "Health Guard",
    "description": "启动前健康检查插件，确保 OpenCode 配置正确",
    "icon": "🛡️",
    "hooks": [
      "event",
      "config"
    ]
  }
}
